{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "隐阅",
  "version": "0.1.3",
  "identifier": "com.fishbaby.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "隐阅 · 书架",
        "width": 1040,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560
      },
      {
        "label": "reader",
        "title": "隐阅 · 阅读区域",
        "url": "index.html?reader",
        "width": 420,
        "height": 160,
        "minWidth": 220,
        "minHeight": 90,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
