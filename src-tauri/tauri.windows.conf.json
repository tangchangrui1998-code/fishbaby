{
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "隐阅 · 书架",
        "width": 1040,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560
      },
      {
        "label": "reader",
        "title": "隐阅 · 阅读区域",
        "url": "index.html?reader",
        "width": 420,
        "height": 160,
        "minWidth": 220,
        "minHeight": 90,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "create": false
      }
    ]
  }
}
